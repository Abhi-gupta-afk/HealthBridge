# HealthBridge Backend Environment Variables
# Copy this file to .env and update with your actual values

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_PASSWORD=your_secure_password_here

# Mail Configuration (for Notification Service)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_specific_password

# JWT Configuration
JWT_SECRET=your_very_long_secure_jwt_secret_key_here_minimum_256_bits

# Server Ports (default values)
EUREKA_PORT=8761
GATEWAY_PORT=8080
USER_SERVICE_PORT=8081
APPOINTMENT_SERVICE_PORT=8082
NOTIFICATION_SERVICE_PORT=8083
REPORT_SERVICE_PORT=8084
PAYMENT_SERVICE_PORT=8085

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Production Settings
SPRING_PROFILES_ACTIVE=dev
