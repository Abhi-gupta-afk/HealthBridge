#!/bin/bash

# HealthBridge Backend Restructuring Script
echo "Starting HealthBridge Backend Restructuring..."

cd /d/Healthbridge/backend

# Step 1: Clean up old directories and files
echo "Cleaning up old files..."
rm -rf eurekaServer gatewayService userService appointmentService notificationService reportService paymentService 2>/dev/null
rm -rf logs/*.log test-output.log 2>/dev/null
rm -rf */target 2>/dev/null
rm -rf */src/main/resources/static 2>/dev/null
rm -rf */src/main/resources/templates 2>/dev/null

# Step 2: Update Notification Service application.properties
echo "Updating Notification Service..."
cat > notification-service/src/main/resources/application.properties <<'EOF'
spring.application.name=notification-service
server.port=8083

spring.datasource.url=jdbc:mysql://localhost:3306/healthbridge_notification?createDatabaseIfNotExist=true
spring.datasource.username=root
spring.datasource.password=${DB_PASSWORD:abc1234}
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MySQL8Dialect

# Email Configuration (externalize in production)
spring.mail.host=smtp.gmail.com
spring.mail.port=587
spring.mail.username=${MAIL_USERNAME:abhigupta.07112001@gmail.com}
spring.mail.password=${MAIL_PASSWORD:zjiqmfmpleffjpwv}
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true

# Eureka Configuration
eureka.client.service-url.defaultZone=http://localhost:8761/eureka/
eureka.client.register-with-eureka=true
eureka.client.fetch-registry=true
eureka.instance.prefer-ip-address=true

# Actuator Configuration
management.endpoints.web.exposure.include=health,info,metrics,prometheus
management.endpoint.health.show-details=always
management.metrics.export.prometheus.enabled=true

# Swagger Configuration
springdoc.api-docs.path=/api-docs
springdoc.swagger-ui.path=/swagger-ui.html
EOF

# Step 3: Update Report Service application.properties
echo "Updating Report Service..."
cat > report-service/src/main/resources/application.properties <<'EOF'
spring.application.name=report-service
server.port=8084

spring.datasource.url=jdbc:mysql://localhost:3306/healthbridge_report?createDatabaseIfNotExist=true
spring.datasource.username=root
spring.datasource.password=${DB_PASSWORD:abc1234}
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MySQL8Dialect

# File Upload Configuration
spring.servlet.multipart.max-file-size=10MB
spring.servlet.multipart.max-request-size=10MB

# Eureka Configuration
eureka.client.service-url.defaultZone=http://localhost:8761/eureka/
eureka.client.register-with-eureka=true
eureka.client.fetch-registry=true
eureka.instance.prefer-ip-address=true

# Actuator Configuration
management.endpoints.web.exposure.include=health,info,metrics,prometheus
management.endpoint.health.show-details=always
management.metrics.export.prometheus.enabled=true

# Swagger Configuration
springdoc.api-docs.path=/api-docs
springdoc.swagger-ui.path=/swagger-ui.html
EOF

# Step 4: Update Payment Service application.properties
echo "Updating Payment Service..."
cat > payment-service/src/main/resources/application.properties <<'EOF'
spring.application.name=payment-service
server.port=8085

spring.datasource.url=jdbc:mysql://localhost:3306/healthbridge_payment?createDatabaseIfNotExist=true
spring.datasource.username=root
spring.datasource.password=${DB_PASSWORD:abc1234}
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MySQL8Dialect

# Eureka Configuration
eureka.client.service-url.defaultZone=http://localhost:8761/eureka/
eureka.client.register-with-eureka=true
eureka.client.fetch-registry=true
eureka.instance.prefer-ip-address=true

# Actuator Configuration
management.endpoints.web.exposure.include=health,info,metrics,prometheus
management.endpoint.health.show-details=always
management.metrics.export.prometheus.enabled=true

# Swagger Configuration
springdoc.api-docs.path=/api-docs
springdoc.swagger-ui.path=/swagger-ui.html
EOF

echo "✅ Backend restructuring complete!"
echo "✅ All services configured with:"
echo "   - Standardized naming (kebab-case)"
echo "   - Actuator and Prometheus metrics"
echo "   - Eureka service discovery"
echo "   - Swagger documentation"
echo "   - Environment variable support"
